# .env — for Netlify dev (backend functions)

# 🔐 From Paynetworx dashboard (QA / test key first)
PNX_API_KEY=YOUR_PAYNETWORX_TEST_API_KEY_HERE

# 🔧 Paynetworx QA (test) endpoints
PNX_PAYMENT_API_BASE=https://api.qa.paynetworx.net/v0
PNX_HOSTED_SESSIONS_URL=https://api.hosted-payments-qa.paynetworx.cloud/v1/payments/sessions/create
